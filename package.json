{
  "name": "tt-launcher",
  "version": "1.7.5",
  "description": "TT Launcher — NeoForge/Fabric TT Client launcher",
  "main": "dist-electron/main/main.js",
  "author": "The_Algorithm67 <ben757119@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ben757119-cmyk/TT-Client",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "build": {
    "appId": "com.ttclient.launcher",
    "productName": "TT Launcher",
    "copyright": "Copyright © The_Algorithm67 / The Third",
    "directories": { "output": "release", "buildResources": "resources" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "extraResources": [{ "from": "resources/bundled", "to": "bundled", "filter": ["**/*"] }],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "TT-Launcher-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TT Launcher"
    },
    "extraMetadata": { "main": "dist-electron/main/main.js" }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "msmc": "^5.0.5",
    "node-fetch": "^2.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
